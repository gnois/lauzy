let Tag = require('lau.tag')
-- check if ast are the same
let same = \a, b, seen ->
	if a == b
		return true
	if type(a) ~= type(b)
		return false
	if 'table' ~= type(a)
		return a == b
	if not (a and b and a.tag == b.tag)
		return false

	seen = seen or {}
	var row = seen[a]
	if not row
		row = {}
		seen[a] = row
	else if row[b]
		return true
	row[b] = true

	-- http://stackoverflow.com/questions/27674367/lua-check-if-a-table-can-be-looped-through-via-ipairs-ipairs-starting-at-0
	if #a ~= #b
		return false
	-- check array part
	var last = 1
	for i, v in ipairs(a)
		last = i
		if not same(v, b[i], seen)
			return false
	-- check hashmap part
	for k, v in pairs(a)
		if 'number' ~= type(k) or k < 1 or k > last or math.floor(k) ~= k
			-- ignore line,col
			if k ~= 'line' and k ~= 'col'
				if not same(v, b[k], seen)
					return false
	-- b may have more keys than a
	for k, v in pairs(b)
		if 'number' ~= type(k) or k < 1 or k > last or math.floor(k) ~= k
			-- ignore line,col
			if k ~= 'line' and k ~= 'col'
				if not same(v, a[k], seen)
					return false
	return true


let clone = \t, seen ->
	seen = seen or {}
	if type(t) == "table"
		if seen[t]
			return seen[t]
		var copy = {}
		seen[t] = copy
		for i, v in ipairs(t)
			copy[i] = clone(v, seen)
		for k, v in pairs(t)
			copy[clone(k, seen)] = clone(v, seen)
		--setmetatable(copy, clone(getmetatable(t)))
		return copy
	return t


let TType = Tag.Type
-- return the tbl or union of tbl, ...
-- else nil
let get_tbl = \t ->
	var tbl = t
	if t.tag == TType.Or
		for _, v in ipairs(t)
			if v.tag == TType.Tbl
				tbl = v
				break
	if tbl.tag == TType.Tbl
		return tbl


var create = \tag, node ->
	assert('table' == type(node))
	node.tag = tag
	return node

var new_var = \id, level, sub, sup ->
	return create(TType.New, {id = id, level = level or 0, sub = sub or {}, sup = sup or {}})

var dedup = \list ->
	var out = {}
	for _, t in ipairs(list)
		var dup = false
		for __, v in ipairs(out)
			if t == v or same(t, v)
				dup = true
				break
		if not dup
			out[#out + 1] = t
	return out

var flatten = \tag, types ->
	var list, l = {}, 0
	for _, t in ipairs(types)
		if t.tag == tag
			for __, tt in ipairs(t)
				l = l + 1
				list[l] = tt
		else
			l = l + 1
			list[l] = t
	if l > 1
		return dedup(list)
	return list

var keep_varargs = \src, dst ->
	if src and src.varargs
		dst.varargs = true
	return dst

-- Apply lattice laws for Or/And, and unwrap single-element results.
-- absorber: the short-circuit element (Top for Or, Bot for And)
-- identity: the element to drop from the list (Bot for Or, Top for And)
-- Returns true if two concrete (non-var) types are provably disjoint,
-- meaning they can never share a value.  Used to drop trivially satisfied
-- negation constraints in intersections: X & ~Y = X when disjoint(X, Y).
let concrete_disjoint = \a, b ->
	-- Nil vs Val/Func/Tbl/Tuple
	if a.tag == TType.Nil
		return b.tag == TType.Val or b.tag == TType.Func or b.tag == TType.Tbl or b.tag == TType.Tuple
	if b.tag == TType.Nil
		return a.tag == TType.Val or a.tag == TType.Func or a.tag == TType.Tbl or a.tag == TType.Tuple
	-- Two Vals: disjoint only when primitive kinds differ (e.g. num vs str)
	if a.tag == TType.Val and b.tag == TType.Val
		return a.type ~= b.type
	-- Val vs Func/Tbl/Tuple
	if a.tag == TType.Val
		return b.tag == TType.Func or b.tag == TType.Tbl or b.tag == TType.Tuple
	if b.tag == TType.Val
		return a.tag == TType.Func or a.tag == TType.Tbl or a.tag == TType.Tuple
	-- Func vs Tbl/Tuple
	if a.tag == TType.Func
		return b.tag == TType.Tbl or b.tag == TType.Tuple
	if a.tag == TType.Tbl
		if b.tag == TType.Func or b.tag == TType.Tuple
			return true
		if b.tag == TType.Tbl
			for _, p_a in ipairs(a)
				var k_a = p_a[2]
				if type(k_a) == 'string'
					for __, p_b in ipairs(b)
						if p_b[2] == k_a
							if concrete_disjoint(p_a[1], p_b[1])
								return true
			return false
	-- Tuple vs Func/Tbl (Tuple vs Nil/Val already handled above)
	if a.tag == TType.Tuple
		if b.tag == TType.Func or b.tag == TType.Tbl
			return true
		if b.tag == TType.Tuple
			var min_len = math.min(#a, #b)
			for i = 1, min_len
				if concrete_disjoint(a[i], b[i])
					return true
			return false
	if b.tag == TType.Tuple
		return a.tag == TType.Func or a.tag == TType.Tbl
	return false

let compound_type = \tag, parts ->
	var absorber = tag == TType.Or and TType.Top or TType.Bot
	var identity = tag == TType.Or and TType.Bot or TType.Top
	var filtered = {}
	for _, a in ipairs(parts)
		-- T | Top = Top  /  T & Bot = Bot
		if a.tag == absorber
			return create(absorber, {})
		-- T | ~T = Top  /  T & ~T = Bot  (De Morgan complementation)
		if a.tag == TType.Neg
			for __, b in ipairs(parts)
				if same(a[1], b)
					return create(absorber, {})
		-- For And: X & ~Y = X when X and Y are from disjoint type families.
		-- The negation is trivially satisfied and adds no information -- drop it.
		var skip = false
		if tag == TType.And and a.tag == TType.Neg
			var neg_inner = a[1]
			var has_concrete = false
			var all_disjoint = true
			for __, b in ipairs(parts)
				if b ~= a and b.tag ~= TType.Neg and b.tag ~= TType.Top and b.tag ~= TType.Bot
					has_concrete = true
					if not concrete_disjoint(b, neg_inner)
						all_disjoint = false
						break
			if has_concrete and all_disjoint
				skip = true
		-- T | Bot = T  /  T & Top = T  (drop identity elements)
		if not skip and a.tag ~= identity
			filtered[#filtered + 1] = a
	-- Absorption: A | (A & B) = A  /  A & (A | B) = A
	-- An And-term inside Or is redundant if any of its members already appears
	-- in the Or; an Or-term inside And is redundant if any of its members already
	-- appears in the And.
	var sub_tag = tag == TType.Or and TType.And or TType.Or
	var absorbed = {}
	for i, a in ipairs(filtered)
		var drop = false
		if a.tag == sub_tag
			for _, part in ipairs(a)
				for j, b in ipairs(filtered)
					if j ~= i and (part == b or same(part, b))
						drop = true
						break
				if drop
					break
		if not drop
			absorbed[#absorbed + 1] = a
	filtered = absorbed
	-- single-element: unwrap
	if #filtered == 1
		return filtered[1]
	-- empty: return identity element
	if #filtered == 0
		return create(identity, {})
	return create(tag, filtered)

-- table needed, coz some function names are keywords
var Type = {
	nil = ->
		return create(TType.Nil, {})
	, num = ->
		return create(TType.Val, {type = "num"})
	, str = ->
		return create(TType.Val, {type = "str"})
	, bool = ->
		return create(TType.Val, {type = "bool"})
	-- array of types
	, tuple = \types ->
		return create(TType.Tuple, types)
	-- ins and outs are tuples
	, func = \ins, outs ->
		return create(TType.Func, {ins = ins, outs = outs or create(TType.Tuple, {})})
	-- Lua table key can be any type except nil or longstring
	-- If it's string, we'll use back the string literal, else it is a Type object
	-- typetypes is array of { type: type } or { name: type }
	, tbl = \typetypes ->
		return create(TType.Tbl, typetypes)
	, or = \types ->
		return compound_type(TType.Or, flatten(TType.Or, types))
	, and = \types ->
		return compound_type(TType.And, flatten(TType.And, types))
	-- MLstruct: top, bot, neg type constructors
	, top = ->
		return create(TType.Top, {})
	, bot = ->
		return create(TType.Bot, {})
	, neg = \inner ->
		return create(TType.Neg, {inner})
	, mu = \v, inner ->
		return create(TType.Mu, {v, inner})
	, new_var = new_var
}

var varargs = \t ->
	assert(TType[t.tag])  -- must be type node
	t.varargs = true
	return t

-- Return a copy of t with the varargs flag removed (for variable bindings).
-- A bound variable holds a single value, not a varargs pack.
var scalar = \t ->
	if not t or not t.varargs
		return t
	var copy = {}
	for k, v in pairs(t)
		copy[k] = v
	copy.varargs = nil
	return copy

let normalize = \node, seen ->
	seen = seen or {}
	if not node or "table" ~= type(node)
		return node
	if seen[node]
		var bound_var = seen[node]
		if type(bound_var) == "boolean"
			bound_var = Type.new_var("mu")
			seen[node] = bound_var
		return bound_var
	seen[node] = true

	var res = node

	if node.tag == TType.Or or node.tag == TType.And
		var flat = {}
		for _, v in ipairs(node)
			var sv = normalize(v, seen)
			if sv and sv.tag == node.tag
				for __, vv in ipairs(sv)
					flat[#flat + 1] = vv
			else
				flat[#flat + 1] = sv
		flat = dedup(flat)
		if res == node
			res = compound_type(node.tag, flat)

	else if node.tag == TType.Tuple
		var out = {}
		for i, v in ipairs(node)
			out[i] = normalize(v, seen)
		res = Type.tuple(out)

	else if node.tag == TType.Func
		res = {
			tag = TType.Func
			, ins = normalize(node.ins, seen)
			, outs = normalize(node.outs, seen)
		}

	else if node.tag == TType.Tbl
		var out = {}
		for i, tk in ipairs(node)
			var key = tk[2]
			if "table" == type(key)
				key = normalize(key, seen)
			out[i] = { normalize(tk[1], seen), key }
		res = Type.tbl(out)

	else if node.tag == TType.Neg
		var inner = normalize(node[1], seen)
		if inner.tag == TType.Neg
			res = inner[1]
		else if inner.tag == TType.Or
			var all_concrete = true
			for _, v in ipairs(inner)
				if v.tag == TType.New or v.tag == TType.Top or v.tag == TType.Bot
					all_concrete = false
					break
			if all_concrete
				var parts = {}
				for _, v in ipairs(inner)
					parts[#parts + 1] = normalize(Type.neg(v), {})
				res = compound_type(TType.And, flatten(TType.And, parts))
			else
				res = Type.neg(inner)
		else if inner.tag == TType.And
			var all_concrete = true
			for _, v in ipairs(inner)
				if v.tag == TType.New or v.tag == TType.Top or v.tag == TType.Bot
					all_concrete = false
					break
			if all_concrete
				var parts = {}
				for _, v in ipairs(inner)
					parts[#parts + 1] = normalize(Type.neg(v), {})
				res = compound_type(TType.Or, flatten(TType.Or, parts))
			else
				res = Type.neg(inner)
		else
			res = Type.neg(inner)

	if type(seen[node]) == "table"
		res = create(TType.Mu, {seen[node], res})

	seen[node] = nil
	return keep_varargs(node, res)


let prune = \node, seen ->
	seen = seen or {}
	if not node or "table" ~= type(node)
		return node
	if seen[node]
		return node
	seen[node] = true

	var res = node

	if node.tag == TType.Or or node.tag == TType.And
		var flat = {}
		for _, v in ipairs(node)
			flat[#flat + 1] = prune(v, seen)
		res = compound_type(node.tag, flat)

	else if node.tag == TType.Tuple
		var out = {}
		for i, v in ipairs(node)
			out[i] = prune(v, seen)
		res = Type.tuple(out)

	else if node.tag == TType.Func
		res = {
			tag = TType.Func
			, ins = prune(node.ins, seen)
			, outs = prune(node.outs, seen)
		}

	else if node.tag == TType.Tbl
		var out = {}
		for i, tk in ipairs(node)
			var key = tk[2]
			if "table" == type(key)
				key = prune(key, seen)
			out[i] = { prune(tk[1], seen), key }
		res = Type.tbl(out)

	else if node.tag == TType.Neg
		res = Type.neg(prune(node[1], seen))

	else if node.tag == TType.Mu
		res = Type.mu(prune(node[1], seen), prune(node[2], seen))

	seen[node] = nil
	return keep_varargs(node, res)

let calc_polarities = \node, pol, res, seen ->
	seen = seen or {}
	if not node or "table" ~= type(node)
		return res
	if seen[node]
		return res
	seen[node] = true

	if node.tag == TType.New
		var id = node.id
		if not res[id]
			res[id] = {pos = 0, neg = 0}
		if pol > 0
			res[id].pos = res[id].pos + 1
		else if pol < 0
			res[id].neg = res[id].neg + 1
		else
			res[id].pos = res[id].pos + 1
			res[id].neg = res[id].neg + 1

	else if node.tag == TType.Or or node.tag == TType.And
		for _, v in ipairs(node)
			calc_polarities(v, pol, res, seen)

	else if node.tag == TType.Tuple
		for _, v in ipairs(node)
			calc_polarities(v, pol, res, seen)

	else if node.tag == TType.Func
		calc_polarities(node.ins, -pol, res, seen)
		calc_polarities(node.outs, pol, res, seen)

	else if node.tag == TType.Tbl
		for _, tk in ipairs(node)
			calc_polarities(tk[1], 0, res, seen) -- invar
			if type(tk[2]) == "table"
				calc_polarities(tk[2], 0, res, seen) -- invar

	else if node.tag == TType.Neg
		calc_polarities(node[1], -pol, res, seen)

	else if node.tag == TType.Mu
		calc_polarities(node[2], pol, res, seen)

	seen[node] = nil
	return res

let inline_bounds = \node, polarities, seen ->
	seen = seen or {}
	if not node or "table" ~= type(node)
		return node
	if seen[node]
		return node
	seen[node] = true

	var res = node

	if node.tag == TType.New
		var id = node.id
		var p = polarities[id]
		if p
			if p.pos > 0 and p.neg == 0
				res = Type.bot()
			else if p.neg > 0 and p.pos == 0
				res = Type.top()

	else if node.tag == TType.Or or node.tag == TType.And
		var flat = {}
		for _, v in ipairs(node)
			flat[#flat + 1] = inline_bounds(v, polarities, seen)
		res = compound_type(node.tag, flat)

	else if node.tag == TType.Tuple
		var out = {}
		for i, v in ipairs(node)
			out[i] = inline_bounds(v, polarities, seen)
		res = Type.tuple(out)

	else if node.tag == TType.Func
		res = {
			tag = TType.Func
			, ins = inline_bounds(node.ins, polarities, seen)
			, outs = inline_bounds(node.outs, polarities, seen)
		}

	else if node.tag == TType.Tbl
		var out = {}
		for i, tk in ipairs(node)
			var key = tk[2]
			if "table" == type(key)
				key = inline_bounds(key, polarities, seen)
			out[i] = { inline_bounds(tk[1], polarities, seen), key }
		res = Type.tbl(out)

	else if node.tag == TType.Neg
		res = Type.neg(inline_bounds(node[1], polarities, seen))

	else if node.tag == TType.Mu
		res = Type.mu(inline_bounds(node[1], polarities, seen), inline_bounds(node[2], polarities, seen))

	seen[node] = nil
	return keep_varargs(node, res)

let distribute = \node, seen ->
	seen = seen or {}
	if not node or "table" ~= type(node)
		return node
	if seen[node]
		return node
	seen[node] = true

	var res = node

	if node.tag == TType.And
		var flat = {}
		for _, v in ipairs(node)
			flat[#flat + 1] = distribute(v, seen)

		var distributed = false
		for i, v in ipairs(flat)
			if v.tag == TType.Or
				var rest = {}
				for j, w in ipairs(flat)
					if j ~= i
						rest[#rest + 1] = w
				var branches = {}
				for _, branch in ipairs(v)
					var parts = { branch }
					for __, w in ipairs(rest)
						parts[#parts + 1] = w
					branches[#branches + 1] = distribute(compound_type(TType.And, parts), {})
				res = compound_type(TType.Or, branches)
				distributed = true
				break
		if not distributed
			res = compound_type(TType.And, flat)

	else if node.tag == TType.Or
		var flat = {}
		for _, v in ipairs(node)
			flat[#flat + 1] = distribute(v, seen)
		res = compound_type(TType.Or, flat)

	else if node.tag == TType.Tuple
		var out = {}
		for i, v in ipairs(node)
			out[i] = distribute(v, seen)
		res = Type.tuple(out)

	else if node.tag == TType.Func
		res = {
			tag = TType.Func
			, ins = distribute(node.ins, seen)
			, outs = distribute(node.outs, seen)
		}

	else if node.tag == TType.Tbl
		var out = {}
		for i, tk in ipairs(node)
			var key = tk[2]
			if "table" == type(key)
				key = distribute(key, seen)
			out[i] = { distribute(tk[1], seen), key }
		res = Type.tbl(out)

	else if node.tag == TType.Neg
		res = Type.neg(distribute(node[1], seen))

	else if node.tag == TType.Mu
		res = Type.mu(distribute(node[1], seen), distribute(node[2], seen))

	seen[node] = nil
	return keep_varargs(node, res)

let simplify = \node, seen ->
	var n = normalize(node, seen)
	var d = distribute(n, {})
	var p = prune(d, {})
	var pols = calc_polarities(p, 1, {}, {})
	var final = inline_bounds(p, pols, {})
	return final


----------------- type to string ------------------
var Str = {}
var Prec = {
	[TType.Or] = 1
	, [TType.And] = 2
	, [TType.Func] = 0
}

var tostr
var render = \t, parent_prec ->
	assert(TType[t.tag])
	parent_prec = parent_prec or -1
	var rule = Str[t.tag]
	var s = rule(t)
	-- only show varargs (*) on abstract types (type vars, Top, Bot)
	-- never on concrete types (Val/nil/str/num/bool, Tbl, Func, Tuple) to avoid misleading nil*, str* etc.
	if t.varargs and (t.tag == TType.New or t.tag == TType.Top or t.tag == TType.Bot)
		s = s .. "*"
	var my_prec = Prec[t.tag] or 3
	if my_prec < parent_prec
		return "(" .. s .. ")"
	return s

tostr = \t ->
	return render(t, -1)

-- build switch table only once
Str[TType.New] = \t ->
	return "T" .. t.id
Str[TType.Nil] = ->
	return "nil"
Str[TType.Val] = \t ->
	return t.type
Str[TType.Tuple] = \t ->
	var out = {}
	for i, v in ipairs(t)
		out[i] = render(v, -1)
	--if #out == 1
	--	return out[1]
	return '(' .. table.concat(out, ', ') .. ')'
Str[TType.Func] = \t ->
	return table.concat({render(t.ins, 3), '->', render(t.outs, 3)})
Str[TType.Tbl] = \t ->
	var out, o = {}, 1
	var val
	for _, pair in ipairs(t)
		var vty = pair[1]
		var kty = pair[2]
		if kty
			if "string" == type(kty)
				out[o] = kty .. ': ' .. render(vty, 3)
			else
				out[o] = render(kty, 3) .. ': ' .. render(vty, 3)
			o = o + 1
		else
			val = render(vty, 3)
	if val
		out[o] = val
	return '{' .. table.concat(out, ', ') .. '}'

var flat_renderer = \own_tag, sep, prec ->
	-- identity: the element that contributes nothing to the compound (Bot for Or, Top for And)
	var identity = own_tag == TType.Or and TType.Bot or TType.Top
	return \t ->
		var list, seen = {}, {}
		let collect = \node ->
			if node.tag == own_tag
				for _, x in ipairs(node)
					collect(x)
			else if node.tag == TType.Tuple and #node == 1
				collect(node[1])
			else
				-- T | None = T  /  T & Any = T: skip identity elements at render time
				if node.tag == identity
					return
				var s = render(node, prec)
				if not seen[s]
					seen[s] = true
					list[#list + 1] = s
		for _, x in ipairs(t)
			collect(x)
		-- if everything was filtered (e.g. Or{None,None}), the whole thing is the identity
		if #list == 0
			list[1] = Str[identity]({})
		return table.concat(list, sep)

Str[TType.Or] = flat_renderer(TType.Or, '|', Prec[TType.Or])
Str[TType.And] = flat_renderer(TType.And, '&', Prec[TType.And])
-- MLstruct: Top, Bot, Neg renderers
Str[TType.Top] = -> return "Any"
Str[TType.Bot] = -> return "None"
Str[TType.Neg] = \t -> return "~" .. render(t[1], 3)
Str[TType.Mu] = \t -> return "mu " .. t.id .. ". " .. render(t.inner, 3)
var tuple_none_t = Type.tuple({})

return {
	-- always return fresh instances so keep_varargs mutations don't corrupt shared singletons
	nil = Type.nil
	, num = Type.num
	, str = Type.str
	, bool = Type.bool
	, top = Type.top
	, bot = Type.bot
	, tuple = Type.tuple
	, func = Type.func
	, tbl = Type.tbl
	, or = Type.or
	, and = Type.and
	, neg = Type.neg
	, mu = Type.mu
	, new_var = Type.new_var
	, tuple_none = -> return tuple_none_t
	, varargs = varargs
	, scalar = scalar
	, same = same
	, clone = clone
	, get_tbl = get_tbl
	, keep_varargs = keep_varargs
	, simplify = simplify
	, tostr = tostr
}


------------------ type annotation ------------------------
--``
# number
$ string
! bool
. vararg <- perhaps not needed
[:] type tuple to type tuple - function
{:} type to type - table
{} array
Either:
  ? nil if used by itself. #? means num|nil.
  [$:?] means function taking string, returns nil, or just [$:], bcoz Lua function returns nil by default
  [$.:#|(!, str)] means func take string, return number or tuple(bool, str)

1,2,3, .. typevar
Eg:
var x&6 means var x #
var y $#!  means y is a value type
--``
