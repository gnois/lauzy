let Tag = require('lt.tag')
-- check if ast are the same
let same = \a, b, seen ->
	if a == b
		return true
	if type(a) ~= type(b)
		return false
	if 'table' ~= type(a)
		return a == b
	if not (a and b and a.tag == b.tag)
		return false

	seen = seen or {}
	var row = seen[a]
	if not row
		row = {}
		seen[a] = row
	else if row[b]
		return true
	row[b] = true

	-- http://stackoverflow.com/questions/27674367/lua-check-if-a-table-can-be-looped-through-via-ipairs-ipairs-starting-at-0
	if #a ~= #b
		return false
	-- check array part
	var last = 1
	for i, v in ipairs(a)
		last = i
		if not same(v, b[i], seen)
			return false
	-- check hashmap part
	for k, v in pairs(a)
		if 'number' ~= type(k) or k < 1 or k > last or math.floor(k) ~= k
			-- ignore line,col
			if k ~= 'line' and k ~= 'col'
				if not same(v, b[k], seen)
					return false
	-- b may have more keys than a
	for k, v in pairs(b)
		if 'number' ~= type(k) or k < 1 or k > last or math.floor(k) ~= k
			-- ignore line,col
			if k ~= 'line' and k ~= 'col'
				if not same(v, a[k], seen)
					return false
	return true


let clone = \t, seen ->
	seen = seen or {}
	if type(t) == "table"
		if seen[t]
			return seen[t]
		var copy = {}
		seen[t] = copy
		for i, v in ipairs(t)
			copy[i] = clone(v, seen)
		for k, v in pairs(t)
			copy[clone(k, seen)] = clone(v, seen)
		--setmetatable(copy, clone(getmetatable(t)))
		return copy
	return t


let TType = Tag.Type
-- return the tbl or union of tbl, ...
-- else nil
let get_tbl = \t ->
	var tbl = t
	if t.tag == TType.Or
		for _, v in ipairs(t)
			if v.tag == TType.Tbl
				tbl = v
				break
	if tbl.tag == TType.Tbl
		return tbl


var create = \tag, node ->
	assert('table' == type(node))
	node.tag = tag
	return node

var new_var = \id, level, sub, sup ->
	return create(TType.New, {id = id, level = level or 0, sub = sub or {}, sup = sup or {}})

var dedup = \list ->
	var out = {}
	for _, t in ipairs(list)
		var dup = false
		for __, v in ipairs(out)
			if t == v or same(t, v)
				dup = true
				break
		if not dup
			out[#out + 1] = t
	return out

var flatten = \tag, types ->
	var list, l = {}, 0
	for _, t in ipairs(types)
		if t.tag == tag
			for __, tt in ipairs(t)
				l = l + 1
				list[l] = tt
		else
			l = l + 1
			list[l] = t
	if l > 1
		return dedup(list)
	return list

var keep_varargs = \src, dst ->
	if src and src.varargs
		dst.varargs = true
	return dst

-- Apply lattice laws for Or/And, and unwrap single-element results.
-- absorber: the short-circuit element (Top for Or, Bot for And)
-- identity: the element to drop from the list (Bot for Or, Top for And)
let compound_type = \tag, parts ->
	var absorber = tag == TType.Or and TType.Top or TType.Bot
	var identity = tag == TType.Or and TType.Bot or TType.Top
	var filtered = {}
	for _, a in ipairs(parts)
		-- T | Top = Top  /  T & Bot = Bot
		if a.tag == absorber
			return create(absorber, {})
		-- T | ~T = Top  /  T & ~T = Bot  (De Morgan complementation)
		if a.tag == TType.Neg
			for __, b in ipairs(parts)
				if same(a[1], b)
					return create(absorber, {})
		-- T | Bot = T  /  T & Top = T  (drop identity elements)
		if a.tag ~= identity
			filtered[#filtered + 1] = a
	-- single-element: unwrap
	if #filtered == 1
		return filtered[1]
	-- empty: return identity element
	if #filtered == 0
		return create(identity, {})
	return create(tag, filtered)

-- table needed, coz some function names are keywords
var Type = {
	nil = ->
		return create(TType.Nil, {})
	, num = ->
		return create(TType.Val, {type = "num"})
	, str = ->
		return create(TType.Val, {type = "str"})
	, bool = ->
		return create(TType.Val, {type = "bool"})
	-- array of types
	, tuple = \types ->
		return create(TType.Tuple, types)
	-- ins and outs are tuples
	, func = \ins, outs ->
		return create(TType.Func, {ins = ins, outs = outs or create(TType.Tuple, {})})
	-- Lua table key can be any type except nil or longstring
	-- If it's string, we'll use back the string literal, else it is a Type object
	-- typetypes is array of { type: type } or { name: type }
	, tbl = \typetypes ->
		return create(TType.Tbl, typetypes)
	, or = \types ->
		return compound_type(TType.Or, flatten(TType.Or, types))
	, and = \types ->
		return compound_type(TType.And, flatten(TType.And, types))
	-- MLstruct: top, bot, neg type constructors
	, top = ->
		return create(TType.Top, {})
	, bot = ->
		return create(TType.Bot, {})
	, neg = \inner ->
		return create(TType.Neg, {inner})
	, new_var = new_var
}

var varargs = \t ->
	assert(TType[t.tag])  -- must be type node
	t.varargs = true
	return t

let simplify = \node, seen ->
	seen = seen or {}
	if not node or "table" ~= type(node)
		return node
	if seen[node]
		return node
	seen[node] = true

	if node.tag == TType.Or or node.tag == TType.And
		var flat = {}
		for _, v in ipairs(node)
			var sv = simplify(v, seen)
			if sv and sv.tag == node.tag
				for __, vv in ipairs(sv)
					flat[#flat + 1] = vv
			else
				flat[#flat + 1] = sv
		flat = dedup(flat)
		return keep_varargs(node, compound_type(node.tag, flat))

	if node.tag == TType.Tuple
		var out = {}
		for i, v in ipairs(node)
			out[i] = simplify(v, seen)
		return keep_varargs(node, Type.tuple(out))

	if node.tag == TType.Func
		return keep_varargs(node, {
			tag = TType.Func
			, ins = simplify(node.ins, seen)
			, outs = simplify(node.outs, seen)
		})

	if node.tag == TType.Tbl
		var out = {}
		for i, tk in ipairs(node)
			var key = tk[2]
			if "table" == type(key)
				key = simplify(key, seen)
			out[i] = { simplify(tk[1], seen), key }
		return keep_varargs(node, Type.tbl(out))

	-- MLstruct: negation simplifies by simplifying its inner type
	if node.tag == TType.Neg
		return keep_varargs(node, Type.neg(simplify(node[1], seen)))

	if node.tag == TType.Top or node.tag == TType.Bot
		return node

	return node


----------------- type to string ------------------
var Str = {}
var Prec = {
	[TType.Or] = 1
	, [TType.And] = 2
	, [TType.Func] = 0
}

var tostr
var render = \t, parent_prec ->
	assert(TType[t.tag])
	parent_prec = parent_prec or -1
	var rule = Str[t.tag]
	var s = rule(t)
	-- only show varargs (*) on abstract types (type vars, Top, Bot)
	-- never on concrete types (Val/nil/str/num/bool, Tbl, Func, Tuple) to avoid misleading nil*, str* etc.
	if t.varargs and (t.tag == TType.New or t.tag == TType.Top or t.tag == TType.Bot)
		s = s .. "*"
	var my_prec = Prec[t.tag] or 3
	if my_prec < parent_prec
		return "(" .. s .. ")"
	return s

tostr = \t ->
	return render(t, -1)

-- build switch table only once
Str[TType.New] = \t ->
	return "T" .. t.id
Str[TType.Nil] = ->
	return "nil"
Str[TType.Val] = \t ->
	return t.type
Str[TType.Tuple] = \t ->
	var out = {}
	for i, v in ipairs(t)
		out[i] = render(v, -1)
	--if #out == 1
	--	return out[1]
	return '(' .. table.concat(out, ', ') .. ')'
Str[TType.Func] = \t ->
	return table.concat({render(t.ins, 3), '->', render(t.outs, 3)})
Str[TType.Tbl] = \t ->
	var out, o = {}, 1
	var val
	for _, pair in ipairs(t)
		var vty = pair[1]
		var kty = pair[2]
		if kty
			if "string" == type(kty)
				out[o] = kty .. ': ' .. render(vty, 3)
			else
				out[o] = render(kty, 3) .. ': ' .. render(vty, 3)
			o = o + 1
		else
			val = render(vty, 3)
	if val
		out[o] = val
	return '{' .. table.concat(out, ', ') .. '}'

var flat_renderer = \own_tag, sep, prec ->
	-- identity: the element that contributes nothing to the compound (Bot for Or, Top for And)
	var identity = own_tag == TType.Or and TType.Bot or TType.Top
	return \t ->
		var list, seen = {}, {}
		let collect = \node ->
			if node.tag == own_tag
				for _, x in ipairs(node)
					collect(x)
			else if node.tag == TType.Tuple and #node == 1
				collect(node[1])
			else
				-- T | None = T  /  T & Any = T: skip identity elements at render time
				if node.tag == identity
					return
				var s = render(node, prec)
				if not seen[s]
					seen[s] = true
					list[#list + 1] = s
		for _, x in ipairs(t)
			collect(x)
		-- if everything was filtered (e.g. Or{None,None}), the whole thing is the identity
		if #list == 0
			list[1] = Str[identity]({})
		return table.concat(list, sep)

Str[TType.Or] = flat_renderer(TType.Or, '|', Prec[TType.Or])
Str[TType.And] = flat_renderer(TType.And, '&', Prec[TType.And])
-- MLstruct: Top, Bot, Neg renderers
Str[TType.Top] = -> return "Any"
Str[TType.Bot] = -> return "None"
Str[TType.Neg] = \t -> return "~" .. render(t[1], 3)
var tuple_none_t = Type.tuple({})

return {
	-- always return fresh instances so keep_varargs mutations don't corrupt shared singletons
	nil = Type.nil
	, num = Type.num
	, str = Type.str
	, bool = Type.bool
	, top = Type.top
	, bot = Type.bot
	, tuple = Type.tuple
	, func = Type.func
	, tbl = Type.tbl
	, or = Type.or
	, and = Type.and
	, neg = Type.neg
	, new_var = Type.new_var
	, tuple_none = -> return tuple_none_t
	, varargs = varargs
	, same = same
	, clone = clone
	, get_tbl = get_tbl
	, keep_varargs = keep_varargs
	, simplify = simplify
	, tostr = tostr
}


------------------ type annotation ------------------------
--``
# number
$ string
! bool
. vararg <- perhaps not needed
[:] type tuple to type tuple - function
{:} type to type - table
{} array
Either:
  - optional/nillable. If used in func return [:-] means void  <- NOPE
  ? nil if used by itself. *? means nillable. [$:?] means function taking string, returns nil
1,2,3, .. typevar
Eg:
var x&6 means var x #
var y $#!  means y is a value type
--``
